#!/usr/bin/env bash
# PreToolUse guard hook for polyforge v1 — AI-attribution commit/PR guard, plus a small
# belt of git-workflow guards (worktree gate / protected-branch push / finishing-ops gate).
# Before a tool writes git-visible text or performs a git-workflow-sensitive operation, this
# guard inspects the call and DENYs it with a feedback reason so the model corrects course.
#
# Intercepted tools (matcher in hooks.json) and the fields scanned:
#   pf_commit -> message ; pf_pr -> title,body ; pf_wrap -> pr_title,pr_body ;
#   pf_ship   -> message,pr_title,pr_body (it fuses all three, aihub#286) ;
#   Bash      -> command. The attribution scan only fires for `git commit`/`git merge -m`/
#                `git tag -m`/`gh pr` invocations (else inert). The git-workflow rules below
#                fire for any Bash `git commit`/`git push`/`git merge`/`git branch -D|-d`/
#                `git worktree remove` invocation.
#
# FAIL-OPEN on any internal error (no python3, unparseable payload, filesystem surprises):
# exit 0, never block a legitimate call. Every rule here backstops a soft convention; a bug
# in the guard must never wedge real work — so each new rule is wrapped so an exception in it
# can only fall through to "allow", never "deny".
#
# NOTE: the PreToolUse payload arrives on this script's stdin. We capture it into an env var
# FIRST, because the python program is delivered to python3 via a heredoc on python3's stdin
# — so python's sys.stdin is the heredoc, NOT the hook payload (mirrors the sibling hooks).

set -euo pipefail
command -v python3 >/dev/null 2>&1 || exit 0  # no python3 -> inert, never block

PF_PAYLOAD="$(cat)" python3 <<'PY'
import json, os, re, shlex, sys

raw = os.environ.get("PF_PAYLOAD", "")
try:
    payload = json.loads(raw) if raw.strip() else {}
except ValueError:
    sys.exit(0)  # unparseable payload -> fail-open
if not isinstance(payload, dict):
    sys.exit(0)

tool = payload.get("tool_name") or payload.get("toolName") or ""
ti = payload.get("tool_input")
if ti is None:
    # Copilot CLI delivers tool args as a JSON-encoded string under `toolArgs` (MCP
    # tools) — decode it. (Non-JSON toolArgs, e.g. an apply_patch envelope, is not a
    # commit/PR surface and simply parses to {}.)
    ta = payload.get("toolArgs")
    if isinstance(ta, str):
        try:
            ti = json.loads(ta) if ta.strip() else {}
        except ValueError:
            ti = {}
    else:
        ti = ta
if not isinstance(ti, dict):
    sys.exit(0)

def deny(reason):
    # Emit both shapes: Claude Code / Codex read hookSpecificOutput.permissionDecision;
    # Copilot CLI reads the top-level permissionDecision (verified on 1.0.68 — the nested
    # shape is ignored there and exit code 2 does nothing). Each runtime ignores the
    # key it does not use.
    out = {
        "permissionDecision": "deny",
        "permissionDecisionReason": reason,
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": reason,
        },
    }
    print(json.dumps(out))
    sys.exit(0)

PROTECTED_BRANCHES = {"main", "master", "dev", "tot"}


# ---------------------------------------------------------------------------
# Shared helpers for the Bash git-workflow rules. All are best-effort and must
# never raise past their caller — every call site below is wrapped in
# try/except so a helper bug degrades to fail-open, not a false deny.
# ---------------------------------------------------------------------------

def split_command(cmd):
    try:
        return shlex.split(cmd)
    except ValueError:
        return cmd.split()

def dash_c_dir(cmd):
    """Best-effort extraction of a `-C <path>` argument from a git invocation."""
    try:
        toks = split_command(cmd)
    except Exception:
        return None
    for i, t in enumerate(toks):
        if t == "-C" and i + 1 < len(toks):
            return toks[i + 1]
        if t.startswith("-C") and len(t) > 2:
            return t[2:]
    return None

def effective_dir(cmd, payload):
    d = dash_c_dir(cmd)
    if d:
        return d
    cwd = payload.get("cwd")
    return cwd if isinstance(cwd, str) and cwd else None

def find_workspace_root(start_dir):
    """Walk up from start_dir looking for .polyforge.yaml; None if not found."""
    try:
        cur = os.path.abspath(start_dir)
    except Exception:
        return None
    seen = 0
    while seen < 64:  # sane bound against symlink loops / bad input
        candidate = os.path.join(cur, ".polyforge.yaml")
        if os.path.isfile(candidate):
            return cur
        parent = os.path.dirname(cur)
        if parent == cur:
            return None
        cur = parent
        seen += 1
    return None

def _indent_of(line):
    return len(line) - len(line.lstrip(" "))

def parse_project_repo_names(ws_root):
    """Minimal line-scan parse of projects.*.repos[].name out of .polyforge.yaml.
    No YAML library dependency — the file has a known, simple shape (see pf init
    output), but indentation width can vary, so this tracks indent depth
    generically rather than hardcoding column counts. Returns a set of repo
    names, or an empty set on any parse trouble (caller must treat an empty
    set as "cannot determine", i.e. fail-open)."""
    names = set()
    path = os.path.join(ws_root, ".polyforge.yaml")
    try:
        with open(path, "r", encoding="utf-8") as f:
            raw_lines = f.readlines()
    except OSError:
        return names

    # Drop blank/comment lines; keep (indent, stripped_text) pairs.
    lines = []
    for line in raw_lines:
        text = line.rstrip("\n")
        if not text.strip() or text.lstrip().startswith("#"):
            continue
        lines.append((_indent_of(text), text.strip()))

    projects_indent = None
    repos_indent = None
    name_re = re.compile(r'^-\s*name:\s*(.+?)\s*$')
    in_repos = False
    for indent, text in lines:
        if projects_indent is None:
            if text == "projects:":
                projects_indent = indent
            continue
        if indent <= projects_indent:
            break  # dedented back out of (or past) the projects: block

        if in_repos:
            if indent > repos_indent:
                m = name_re.match(text)
                if m:
                    names.add(m.group(1).strip().strip('"\''))
                continue
            in_repos = False  # dedented out of the repos: list

        if text == "repos:":
            in_repos = True
            repos_indent = indent
    return names

# git global flags that consume the following token as a value (must be skipped
# when scanning for the subcommand, e.g. `git -C <path> commit ...`).
GIT_GLOBAL_VALUE_FLAGS = {"-C", "-c", "--git-dir", "--work-tree", "--namespace"}

def is_git_commit_or_push(toks):
    if not toks or toks[0] != "git":
        return None
    skip_next = False
    for t in toks[1:]:
        if skip_next:
            skip_next = False
            continue
        if t in ("commit", "push"):
            return t
        if t in GIT_GLOBAL_VALUE_FLAGS:
            skip_next = True
            continue
        if t.startswith("-"):
            continue
        # first non-flag, non-known-global token that isn't commit/push -> not our command
        break
    return None

def worktree_gate_check(cmd, payload):
    """Rule 1a: deny git commit/push whose effective dir sits inside a project's
    shared .repo/<name> clone rather than a claimed pf.*/<name> worktree."""
    toks = split_command(cmd)
    if is_git_commit_or_push(toks) is None:
        return None
    edir = effective_dir(cmd, payload)
    if not edir:
        return None
    ws_root = find_workspace_root(edir)
    if not ws_root:
        return None
    repo_names = parse_project_repo_names(ws_root)
    if not repo_names:
        return None
    abs_edir = os.path.abspath(edir)
    repo_root = os.path.join(ws_root, ".repo")
    try:
        rel = os.path.relpath(abs_edir, repo_root)
    except ValueError:
        return None  # different drive etc. -> fail-open
    if rel.startswith(".."):
        return None  # not under .repo at all
    first_seg = rel.split(os.sep, 1)[0]
    if first_seg in repo_names:
        return (
            "[polyforge commit-guard] BLOCKED: this git write targets the shared "
            f"clone `.repo/{first_seg}` instead of a claimed worktree. All git commits/"
            "pushes must happen inside a claimed worktree (`pf.<slug>/{}/`), never in "
            "the shared `.repo/<name>` clone shared by every session. Run /pf-work to "
            "claim a work item and get a worktree, then retry there.".format(first_seg)
        )
    return None

def parse_push_target_branch(toks):
    """Best-effort extraction of the branch a `git push` targets. Returns None if
    it cannot be determined confidently (fail-open is the caller's job)."""
    if not toks or toks[0] != "git":
        return None
    if "push" not in toks:
        return None
    i = toks.index("push")
    rest = toks[i + 1:]
    # Drop flags (bail on -C's argument etc. — not expected after `push` but be safe).
    positional = []
    skip_next = False
    for t in rest:
        if skip_next:
            skip_next = False
            continue
        if t in ("-C",):
            skip_next = True
            continue
        if t.startswith("-"):
            continue
        positional.append(t)
    if not positional:
        return None  # `git push` with no args -> pushes current branch to its upstream; can't tell here
    if len(positional) == 1:
        # Could be a remote alone, or a refspec alone (rare without a remote). Treat
        # a bare single token as ambiguous unless it contains ':' or looks like a branch.
        target = positional[0]
    else:
        # <remote> <refspec>
        target = positional[1]
    # refspec forms: "branch", "HEAD:branch", "local:branch", "+local:branch",
    # "main:refs/heads/dev"
    target = target.lstrip("+")
    if ":" in target:
        target = target.split(":", 1)[1]
    # Normalize a fully-qualified ref down to the bare branch name.
    if target.startswith("refs/heads/"):
        target = target[len("refs/heads/"):]
    elif target.startswith("refs/"):
        target = target[len("refs/"):]
    return target or None

def protected_branch_push_check(cmd):
    """Rule 1b: deny `git push` whose target branch is a protected branch."""
    toks = split_command(cmd)
    branch = parse_push_target_branch(toks)
    if not branch:
        return None
    if branch in PROTECTED_BRANCHES:
        return (
            "[polyforge commit-guard] BLOCKED: direct pushes to the protected branch "
            f"`{branch}` are forbidden. Push a task branch and open a PR instead."
        )
    return None

def is_pf_worktree_path(path):
    """True if any path segment looks like a claimed worktree dir (`pf.<slug>`)."""
    try:
        parts = os.path.normpath(path).split(os.sep)
    except Exception:
        return False
    return any(p.startswith("pf.") for p in parts)

def pf_dir_of(path):
    """Return the worktree root: the path prefix up to and including the first
    `pf.<...>` segment (e.g. /data/comp/pf.aihub-205). None if there's none."""
    try:
        norm = os.path.normpath(os.path.abspath(path))
    except Exception:
        return None
    parts = norm.split(os.sep)
    for i, p in enumerate(parts):
        if p.startswith("pf."):
            return os.sep.join(parts[: i + 1]) or os.sep
    return None

# Sidecar state files persist after wrap and are NOT credentials — only the bare
# <wi_id>.json carries the wi's live claim + worktrees map.
_STATE_SIDECAR_SUFFIXES = (".chain.json", ".steps.json", ".artifacts.json")

def owning_state_active(ws_root, pf_dir):
    """True iff a live credential state file OWNS the targeted pf.<...> worktree
    dir — i.e. some wi's `worktrees` map still points inside pf_dir. Lingering
    sidecars (.chain.json/.steps.json/.artifacts.json) are ignored: they persist
    after wrap. Fail-open: any trouble -> False (do not deny)."""
    if not pf_dir:
        return False
    try:
        state_dir = os.path.join(ws_root, ".polyforge", "state")
        if not os.path.isdir(state_dir):
            return False
        pf_dir = os.path.normpath(pf_dir)
        for entry in os.listdir(state_dir):
            if not entry.endswith(".json"):
                continue
            if entry.endswith(_STATE_SIDECAR_SUFFIXES):
                continue  # sidecar, not a credential file
            try:
                with open(os.path.join(state_dir, entry), "r", encoding="utf-8") as f:
                    data = json.load(f)
            except (OSError, ValueError):
                continue  # unreadable/unparseable credential -> skip, fail-open
            if not isinstance(data, dict):
                continue
            wts = data.get("worktrees")
            if not isinstance(wts, dict):
                continue
            for wt in wts.values():
                if not isinstance(wt, str) or not wt:
                    continue
                awt = os.path.normpath(os.path.abspath(wt))
                if awt == pf_dir or awt.startswith(pf_dir + os.sep):
                    return True
        return False
    except OSError:
        return False

FINISHING_OPS_RE = re.compile(
    r'^git\s+(?:.*\s)?(?:'
    r'merge(?!\s+(?:--abort|--continue)\b)\s+\S'
    r'|branch\s+-[dD]\b'
    r'|worktree\s+remove\b'
    r')'
)

def finishing_ops_check(cmd, payload):
    """Rule 1c: deny finishing-integration git ops (merge/branch -d|-D/worktree
    remove) run against a claimed pf.* worktree while its state file is still
    active — those steps belong to the polyforge wrap flow. Once the state file
    is gone (post-wrap cleanup) the same commands must pass."""
    if not FINISHING_OPS_RE.search(cmd):
        return None
    edir = effective_dir(cmd, payload)
    # Also consider any bare path arguments in the command itself (e.g.
    # `git worktree remove pf.foo/bar` relative to edir, or an absolute path).
    candidates = [edir] if edir else []
    try:
        for t in split_command(cmd):
            if "pf." in t and not t.startswith("-"):
                candidates.append(t if os.path.isabs(t) else os.path.join(edir or "", t))
    except Exception:
        pass
    pf_targets = [c for c in candidates if c and is_pf_worktree_path(c)]
    if not pf_targets:
        return None
    # Resolve the targeted worktree root (up to the first pf.<...> segment).
    pf_dir = None
    for c in pf_targets:
        pf_dir = pf_dir_of(c)
        if pf_dir:
            break
    if not pf_dir:
        return None
    ws_root = find_workspace_root(pf_dir)
    if not ws_root:
        return None
    if not owning_state_active(ws_root, pf_dir):
        return None  # post-wrap (credential gone) or another wi -> allow
    return (
        "[polyforge commit-guard] BLOCKED: this integration step (merge/branch delete/"
        "worktree remove) targets a claimed worktree that still has an active work-item "
        "state file. These steps belong to the polyforge wrap flow — run `/pf-stop --wrap` "
        "instead of finishing the branch manually."
    )


# --- which (field, value) text pairs to scan, per tool ---
def field(name):
    v = ti.get(name)
    return (name, v) if isinstance(v, str) and v else None

# A Bash command is scanned for attribution only when it is a git-commit, git-merge -m,
# git-tag -m, or gh-pr invocation; we must not scan unrelated shell. Best-effort: pf_* are
# the primary surface, this is a backstop.
GIT_PR_RE = re.compile(
    r"\bgit\b[^\n]*\bcommit\b"
    r"|\bgit\b[^\n]*\bmerge\b[^\n]*(?:-m\b|--message\b)"
    r"|\bgit\b[^\n]*\btag\b[^\n]*(?:-m\b|--message\b)"
    r"|\bgh\b\s+pr\b",
    re.IGNORECASE,
)

# ---------------------------------------------------------------------------
# aihub#272 — WHICH PART OF A BASH COMMAND IS "TEXT DESTINED FOR GIT"
#
# This guard used to scan the WHOLE command string. That predicate cannot tell
# text about to be WRITTEN into a commit/PR from a pattern used to SEARCH commits
# for that same text, so it denied the only automated check the <undercover> rule
# has:
#
#   for c in $(git rev-list origin/main..HEAD); do git log -1 --format=%B $c; \
#     done | grep -icE 'claude|co-authored'      # audit each commit
#   gh pr view 42 --json body -q .body | grep -iE 'co-authored-by'
#
# Both are read-only audits OF THIS VERY RULE, and both were denied — leaving the
# rule with no machine check at all on an autonomous lane, only the agent's own
# diligence. It also denied any git command whose PATH argument happens to contain
# a watched literal (`.claude-plugin/marketplace.json`). Same family as "a gate
# must read the change, not the state": the predicate was applied to the wrong
# object.
#
# So the scan is narrowed to the VALUES of the flags that actually carry text into
# git, plus the contents of any message file named by -F/--file. Everything else on
# the command line — subcommands, paths, grep patterns, pipeline stages — is not
# destined for git and is not scanned.
#
# 🔴 NARROWING IS ONLY SAFE WHERE THE PARSE IS TRUSTWORTHY. Four shapes put the
# message somewhere this parser cannot see, and each falls back to the old
# whole-command scan rather than reporting "clean":
#   * shlex cannot split the command;
#   * a heredoc (`<<`) — `git commit -F -` takes its message from the command text;
#   * a message file named `-` (stdin), same reason;
#   * an extracted value containing a shell expansion ($VAR, $(...), `...`), or a
#     named message file that cannot be read — which usually means an earlier part
#     of the same command line is about to create it.
# Fail toward the wider scan, never toward silence.
# ---------------------------------------------------------------------------

# Flags whose VALUE is text that lands in git. `-t` and `-F` mean different things
# to the two tools (`git commit -t` is a template, `gh pr create -F` is the body
# file), so the tables are per-tool rather than merged.
GIT_TEXT_FLAGS = {"-m", "--message"}
GIT_FILE_FLAGS = {"-F", "--file"}
GH_TEXT_FLAGS = {"-t", "--title", "-b", "--body", "--subject", "--notes"}
GH_FILE_FLAGS = {"-F", "--body-file", "--notes-file"}

# Tokens that end one command and begin another inside a single Bash call.
SHELL_SEPARATORS = {"|", "||", "&&", ";", "&", "(", ")", "{", "}", "!"}

# A value the guard cannot resolve to a literal: it is produced by the shell.
SHELL_EXPANSION_RE = re.compile(r"\$\(|\$\{|\$[A-Za-z_]|`")


def _tool_invocations(toks):
    """Every `git` / `gh` invocation in a token stream, as (prog, tokens).

    The tool is NOT assumed to be the first word: it can sit inside a loop body
    (`for c in ...; do git log ...; done`), behind a wrapper (`FOO=1 sudo git
    commit`), inside `find -exec`, or after `cd /x &&`. An invocation runs until
    the next tool token or the next shell separator, whichever comes first, so a
    flag is never attributed to the wrong tool."""
    out = []
    prog, cur = None, []
    for t in toks:
        if t in SHELL_SEPARATORS:
            if prog:
                out.append((prog, cur))
            prog, cur = None, []
            continue
        base = os.path.basename(t)
        if base in ("git", "gh") and (t == base or t.endswith("/" + base)):
            if prog:
                out.append((prog, cur))
            prog, cur = base, [t]
            continue
        if prog:
            cur.append(t)
    if prog:
        out.append((prog, cur))
    return out


def _flag_values(seg, text_flags, file_flags):
    """Pull (flag, value) pairs off one command segment. Handles `-m V`,
    `--message=V`, `-mV` and clustered short flags such as `-am V`."""
    texts, files = [], []
    both = text_flags | file_flags
    short = {f for f in both if len(f) == 2 and f.startswith("-")}
    cluster_re = re.compile(r"^-([A-Za-z]*)([" + "".join(sorted(f[1] for f in short)) + r"])(.*)$") \
        if short else None

    i = 1
    while i < len(seg):
        t = seg[i]
        flag = val = None
        if t in both:
            flag = t
            if i + 1 < len(seg):
                val = seg[i + 1]
                i += 1
        elif t.startswith("--") and "=" in t:
            head = t.split("=", 1)[0]
            if head in both:
                flag, val = head, t.split("=", 1)[1]
        elif cluster_re is not None and not t.startswith("--") and len(t) > 2:
            m = cluster_re.match(t)
            if m and ("-" + m.group(2)) in both:
                flag = "-" + m.group(2)
                if m.group(3):
                    val = m.group(3)
                elif i + 1 < len(seg):
                    val = seg[i + 1]
                    i += 1
        if flag is not None and val is not None:
            (texts if flag in text_flags else files).append((flag, val))
        i += 1
    return texts, files


def bash_attribution_fields(cmd, payload):
    """The (label, text) pairs of a Bash command that are destined for git.

    Returns [("command", cmd)] — the pre-aihub#272 whole-command scan — whenever
    the command's shape means the message could be somewhere this parser does not
    look. Never returns [] for such a command."""
    if "<<" in cmd:  # heredoc: the message body IS the command text
        return [("command", cmd)]
    try:
        toks = shlex.split(cmd)
    except ValueError:
        return [("command", cmd)]

    edir = effective_dir(cmd, payload) or "."
    fields = []
    invocations = _tool_invocations(toks)
    for prog, seg in invocations:
        if prog == "git":
            texts, files = _flag_values(seg, GIT_TEXT_FLAGS, GIT_FILE_FLAGS)
        else:
            texts, files = _flag_values(seg, GH_TEXT_FLAGS, GH_FILE_FLAGS)

        for flag, val in texts:
            if SHELL_EXPANSION_RE.search(val):
                return [("command", cmd)]  # the literal lives elsewhere on the line
            if val:
                fields.append(("%s %s value" % (prog, flag), val))
        for flag, val in files:
            if val == "-" or SHELL_EXPANSION_RE.search(val):
                return [("command", cmd)]
            fpath = val if os.path.isabs(val) else os.path.join(edir, val)
            try:
                with open(fpath, "r", encoding="utf-8", errors="replace") as fh:
                    content = fh.read()
            except OSError:
                # Named but unreadable: most often an earlier stage of this same
                # command line is about to write it. Cannot vouch -> widen.
                return [("command", cmd)]
            if content:
                fields.append(("%s %s file: %s" % (prog, flag, val), content))

    if not invocations:
        # GIT_PR_RE matched but no token is a bare `git`/`gh` invocation (an alias,
        # a quoted command handed to another program, a shell function). Nothing to
        # attribute flags to -> widen.
        return [("command", cmd)]
    return fields

# Tool name is prefix-agnostic: Claude Code exposes the plugin MCP tools as
# mcp__plugin_polyforge_polyforge__pf_*, Codex as mcp__polyforge__pf_*. Match on the bare
# tool name after the last "__" so the guard fires identically under both runtimes (Bash has
# no "__", so it falls through to the Bash branch unchanged).
base_tool = tool.rsplit("__", 1)[-1]
# Copilot CLI names MCP tools `<server>-<tool>` (e.g. polyforge-pf_commit) with no "__";
# strip that server prefix so the guard fires identically under all three harnesses.
if base_tool.startswith("polyforge-"):
    base_tool = base_tool[len("polyforge-"):]
fields = []
bash_cmd = None
if base_tool == "pf_commit":
    fields = [field("message")]
elif base_tool == "pf_pr":
    fields = [field("title"), field("body")]
elif base_tool == "pf_wrap":
    fields = [field("pr_title"), field("pr_body")]
elif base_tool == "pf_ship":
    # pf_ship (aihub#286) fuses commit + push + PR, so it writes ALL THREE kinds
    # of git-visible text in one call and must be scanned for all of them.
    # Fusing tools is exactly how text slips out from under a guard that is
    # keyed on tool name: the guard is not a property of the git operation, it
    # is a property of the entry point, and a new entry point starts unguarded.
    fields = [field("message"), field("pr_title"), field("pr_body")]
elif tool in ("Bash", "bash"):
    cmd = ti.get("command")
    if isinstance(cmd, str) and cmd:
        bash_cmd = cmd

# --- Bash-only git-workflow rules (1a/1b/1c), each independently fail-open ---
if bash_cmd is not None:
    for check in (worktree_gate_check, protected_branch_push_check):
        try:
            reason = check(bash_cmd, payload) if check is worktree_gate_check else check(bash_cmd)
            if reason:
                deny(reason)
        except Exception:
            pass  # any internal error in a new rule -> never block

    try:
        reason = finishing_ops_check(bash_cmd, payload)
        if reason:
            deny(reason)
    except Exception:
        pass

    if GIT_PR_RE.search(bash_cmd):
        try:
            fields = bash_attribution_fields(bash_cmd, payload)
        except Exception:
            fields = [("command", bash_cmd)]  # parser bug -> the old, wider scan

fields = [f for f in fields if f]
if not fields:
    sys.exit(0)  # nothing to scan -> let the call through untouched

# --- the matcher: case-insensitive, custom word boundaries (only [A-Za-z0-9] is a "word"
# char, so hyphenated attribution trailers still bound correctly). The boundaries are why
# `ai` inside maintain/contain/detail/email/domain/chain/explain/again does NOT match: those
# have alphanumerics on both sides of `ai`. Single-word names match only as whole tokens. ---
B  = r"(?<![A-Za-z0-9])"   # left boundary
B2 = r"(?![A-Za-z0-9])"    # right boundary
ALTS = [
    r"claude",            # also catches claude-opus-4-8, claude code (word "claude")
    r"anthropic",
    r"opus",
    r"sonnet",
    r"haiku",
    r"llm",
    r"co[\s-]?authored[\s-]?by",
    r"generated[\s-]+(?:by|with)",
    # aihub#272: `ai` used to be listed here as a standalone token, and it denied a
    # PR body for containing "Siteboon AI B.V." — the legal name of an upstream
    # copyright holder, quoted while doing AGPL section 7 attribution compliance.
    # Naming the copyright holder IS that task; there is no wording around it. It
    # also denies ordinary technical prose ("the AI gateway", "AI-native").
    #
    # A whitelist of exceptions was rejected: it would need "Siteboon AI B.V.",
    # then the next vendor, then the next, and it rots silently in the direction
    # of more false positives. Instead the SHAPE is matched: `ai` counts when it
    # appears in an attribution construction, and separately (below) anywhere
    # inside a trailer block, which is where AI attribution actually lives. The
    # word on its own in a sentence was never what this rule was defending.
    r"ai[\s-]?(?:assisted|generated|authored|written|drafted)",
    r"(?:by|using|used|via)[\s-]+(?:an?[\s-]+|the[\s-]+)?ai",
]
BANNED = re.compile(B + r"(?:" + r"|".join(ALTS) + r")" + B2, re.IGNORECASE)

# The trailer block is the real carrier of an attribution trailer, so the bare
# token `ai` is still judged there — and only there.
BARE_AI = re.compile(B + r"ai" + B2, re.IGNORECASE)
TRAILER_LINE_RE = re.compile(r"^[A-Za-z][A-Za-z0-9-]*:\s*\S")

def trailer_zone(text):
    """The message's trailer block, or "" when it has none.

    git's own definition, reduced to what matters here: the LAST paragraph, every
    line of which is `Key: value` with a space-free key. It must not also be the
    FIRST paragraph — otherwise a one-line conventional-commit subject like
    "feat: AI gateway" parses as a trailer block and the narrowing above is undone
    by this function."""
    paragraphs = re.split(r"\n\s*\n", text.strip())
    if len(paragraphs) < 2:
        return ""
    lines = [ln for ln in paragraphs[-1].split("\n") if ln.strip()]
    if not lines or not all(TRAILER_LINE_RE.match(ln) for ln in lines):
        return ""
    return paragraphs[-1]

def first_hit(text):
    m = BANNED.search(text)
    if m:
        return m.group(0)
    zone = trailer_zone(text)
    if zone:
        m = BARE_AI.search(zone)
        if m:
            return m.group(0)
    return None

for fname, value in fields:
    term = first_hit(value)
    if term:
        reason = (
            f"[polyforge commit-guard] BLOCKED: the {fname} contains the AI-attribution "
            f"string \"{term}\". Per the <undercover> rule, all git output (commit message, "
            f"PR title/body) must read as written by a human developer — no mention of "
            f"Claude / Anthropic / AI / LLM / model names, and no Co-Authored-By / Generated-by "
            f"/ AI-assisted trailers. Rewrite the text to describe only what the change does "
            f"and why, in a plain human-authored tone, then retry."
        )
        deny(reason)

# no hit -> no output, call proceeds
sys.exit(0)
PY
exit 0
