#!/usr/bin/env bash
# PostToolUse bridge hook for polyforge v1.
# When a superpowers design/plan doc is written under docs/superpowers/{specs,plans}/*.md,
# instruct the model to mirror it into aihub as a methodology.spec / methodology.plan
# artifact. Path-gated: emits nothing for any other write, so it is inert when superpowers
# is absent (those files never get written) or when an unrelated file is edited.
#
# Matched on Write|Edit (see hooks.json); the path check below is the real gate.
#
# NOTE: the PostToolUse payload arrives on this script's stdin. We spool it to a temp file
# FIRST, because the python program itself is delivered to python3 via a heredoc on
# python3's stdin — so python's sys.stdin is the heredoc, NOT the hook payload. The payload
# must NOT ride in an env var (the old approach): a large-file edit blows MAX_ARG_STRLEN
# (128KiB per arg/env string) and execve fails with "Argument list too long". A path stays tiny.

set -euo pipefail
command -v python3 >/dev/null 2>&1 || exit 0

PF_PAYLOAD_FILE="$(mktemp)"
trap 'rm -f "$PF_PAYLOAD_FILE"' EXIT
cat > "$PF_PAYLOAD_FILE"
PF_PAYLOAD_FILE="$PF_PAYLOAD_FILE" python3 <<'PY'
import json, os, re, sys, urllib.request

try:
    raw = open(os.environ["PF_PAYLOAD_FILE"], encoding="utf-8").read()
except (KeyError, OSError):
    raw = ""
try:
    payload = json.loads(raw) if raw.strip() else {}
except ValueError:
    sys.exit(0)

ti = payload.get("tool_input") or {}
path = ti.get("file_path") or ti.get("path") or ""
if not path:
    sys.exit(0)

m = re.search(r"(?:^|/)docs/superpowers/(specs|plans)/.+\.md$", path)
if not m:
    sys.exit(0)  # not a superpowers spec/plan doc -> inert

kind = m.group(1)
art_type = "methodology.spec" if kind == "specs" else "methodology.plan"
label = "design/spec" if kind == "specs" else "plan"

def cfg_get(section, key):
    p = os.path.expanduser("~/.polyforge/config.toml"); cur = None
    try:
        for ln in open(p, encoding="utf-8"):
            s = ln.strip()
            if s.startswith("[") and s.endswith("]"): cur = s[1:-1].strip()
            elif cur == section and "=" in s:
                k, _, v = s.partition("=")
                if k.strip() == key: return v.strip().strip("'\"")
    except OSError: pass
    return ""

def find_ws(start):
    d = start or ""; seen = set()
    while d and d != "/" and d not in seen:
        seen.add(d)
        if os.path.isfile(os.path.join(d, ".polyforge.yaml")): return d
        d = os.path.dirname(d)
    return ""

def claimed_state(ws):
    sd = os.path.join(ws, ".polyforge", "state")
    hits = []
    for fn in (os.listdir(sd) if os.path.isdir(sd) else []):
        if not fn.endswith(".json") or fn.endswith(".steps.json") or fn.endswith(".chain.json"): continue
        try: d = json.load(open(os.path.join(sd, fn), encoding="utf-8"))
        except (OSError, ValueError): continue
        if d.get("claimed") and d.get("wi_id"): hits.append(d)
    return hits[0] if len(hits) == 1 else None

def fallback():
    msg = (f"[polyforge bridge] A superpowers {label} doc was written at `{path}` but the bridge could "
           f"NOT save it automatically. If a wi is claimed, call pf_save_artifact(type=\"{art_type}\", "
           f"work_item_id=<current wi>, path=\"{path}\", visibility=\"project\") (pass "
           f"supersedes_memory_id of the prior same-type artifact if re-editing).")
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PostToolUse", "additionalContext": msg}}))
    sys.exit(0)

base = (os.environ.get("POLYFORGE_AIHUB_URL") or cfg_get("server", "url")).rstrip("/")
api_key = os.environ.get("POLYFORGE_API_KEY") or cfg_get("auth", "api_key")
ws = find_ws(os.path.dirname(path)) or find_ws(payload.get("cwd") or "")
st = claimed_state(ws) if ws else None
if not (base and api_key and st):
    fallback()

try:
    content = open(path, encoding="utf-8").read()
except OSError:
    fallback()

# supersede via sidecar: <state>/<wi_id>.artifacts.json maps art_type -> mem_id
side = os.path.join(ws, ".polyforge", "state", st["wi_id"] + ".artifacts.json")
prior = {}
try: prior = json.load(open(side, encoding="utf-8"))
except (OSError, ValueError): pass

body = {"type": art_type, "work_item_id": st["wi_id"], "project": st.get("project"),
        "content": content, "visibility": "project",
        "attempt_id": st.get("attempt_id"), "claim_epoch": st.get("claim_epoch"),
        "session_secret": st.get("session_secret")}
if prior.get(art_type): body["supersedes_memory_id"] = prior[art_type]

if os.environ.get("PF_BRIDGE_DRYRUN"):
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PostToolUse",
        "additionalContext": f"[bridge dryrun] POST {base}/v1/memories {json.dumps({k:body[k] for k in ('type','work_item_id','project')})}"}}))
    sys.exit(0)

req = urllib.request.Request(base + "/v1/memories", data=json.dumps(body).encode(),
        headers={"Authorization": "Bearer " + api_key, "Content-Type": "application/json"}, method="POST")
try:
    with urllib.request.urlopen(req, timeout=5) as r:
        out = json.load(r)
    mem_id = out.get("memory_id") or out.get("id") or "?"
    prior[art_type] = mem_id
    try: json.dump(prior, open(side, "w", encoding="utf-8"))
    except OSError: pass
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PostToolUse",
        "additionalContext": f"[polyforge bridge] {label} doc mirrored to aihub as {mem_id}. Do NOT call pf_save_artifact for this doc."}}))
except Exception:
    fallback()
PY
exit 0
