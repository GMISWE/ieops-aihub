{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/pf-skill-router\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|mcp__plugin_polyforge_polyforge__pf_(commit|pr|wrap)",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/pf-commit-guard\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/pf-session-start\"",
            "async": false
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/pf-repo-sync\"",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_polyforge_polyforge__pf_(claim_work_item|update_step|save_artifact|wrap|complete_attempt)",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/bin/pf-chain-hook.cjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
