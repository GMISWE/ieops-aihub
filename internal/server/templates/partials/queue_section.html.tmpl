{{define "queue_section.html.tmpl"}}
{{if .Err}}<div class="empty" style="max-width:none">{{.Err}}</div>{{end}}

{{/* Count strip only. The actual grouped rows live in the wi list below this
     block — duplicating them here was redundant (the list re-renders the same
     items). This partial is just the four headline counts, polled by HTMX every
     5s from the wi list page. Running / Needs you / Unclaimed are derived from
     the SAME grouping the list renders (so the numbers always equal the visible
     list sections); Stalled comes from the ready-queue path. Supports
     ?project=__all__ by aggregating across accessible projects. All four cells
     share one neutral background — no highlighted cell. */}}
<div class="qstrip">
  <div class="qcell"><div class="n">{{.Strip.Running}}</div><div class="l">Running</div></div>
  <div class="qcell"><div class="n">{{.Strip.NeedsYou}}</div><div class="l">Needs you</div></div>
  <div class="qcell"><div class="n">{{.Strip.Unclaimed}}</div><div class="l">Unclaimed</div></div>
  <div class="qcell"><div class="n">{{.Strip.Stalled}}</div><div class="l">Stalled</div></div>
</div>
{{end}}
