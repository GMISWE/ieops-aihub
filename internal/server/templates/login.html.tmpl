<!DOCTYPE html>
<html lang="en" data-theme="{{.Theme}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sign in — polyforge</title>
<link rel="preload" as="font" type="font/woff2" crossorigin href="/ui/static/fonts/Geist-Variable.woff2">
<link rel="preload" as="font" type="font/woff2" crossorigin href="/ui/static/fonts/GeistMono-Variable.woff2">
<link rel="stylesheet" href="/ui/static/ui.css?v={{assetv}}">
</head>
<body>
<div class="loginwrap">
  <div class="logincard">
    <div class="lb"><span class="mono">p</span> polyforge</div>
    <h1>Sign in to polyforge</h1>
    <p class="sub">Paste an existing API key. Same key the CLI and MCP use.</p>
    {{if .Error}}
      <div class="login-error">{{.Error}}</div>
    {{end}}
    <form method="POST" action="/ui/login">
      <input type="hidden" name="next" value="{{.Next}}">
      <div class="field">
        <label for="api_key">API key</label>
        <input class="input mono" type="password" id="api_key" name="api_key"
               autocomplete="off" autofocus placeholder="pf_k1_…" required>
      </div>
      <button type="submit" class="btn primary" style="width:100%;height:36px">Sign in</button>
    </form>
    <p class="muted">
      Issue a key with <code>polyforge user keys create</code> (admin) or copy from
      <code>~/.polyforge/credentials</code>. The session cookie is valid for 7 days.
    </p>
  </div>
</div>
</body>
</html>
