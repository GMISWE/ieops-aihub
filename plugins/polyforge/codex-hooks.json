{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/pf-session-start\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__polyforge__pf_(commit|pr|wrap)",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/pf-commit-guard\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__polyforge__pf_(claim_work_item|update_step|save_artifact|wrap|complete_attempt)",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/bin/pf-chain-hook.cjs",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "apply_patch|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/pf-superpowers-bridge\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
