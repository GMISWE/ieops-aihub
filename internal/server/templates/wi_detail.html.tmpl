{{define "content"}}
{{if .AccessDenied}}
<div class="empty" style="max-width:none">{{.Err}}</div>
{{else if not .WI}}
<div class="empty" style="max-width:none">
  <div class="et">Work item not found</div>
  {{or .Err "This work item does not exist or you cannot see it."}}
  <div style="margin-top:10px"><a class="link" href="/ui/wi">Back to work items</a></div>
</div>
{{else}}

<div class="crumb">
  <a class="link" href="/ui/wi">Work Items</a>
  <span>/</span>
  <span class="mono">{{or .WI.Slug .WI.ID}}</span>
</div>

{{if .NeedsYou}}
{{/* needs-you bar — this item is awaiting the current user (they own the
     active attempt and it is paused/blocked). Subtle grey treatment mirrors the
     list's Needs you section. */}}
<div class="needs"><span class="dot"></span> Needs you — you own this item and it is {{.WI.Status}}. Resume it to keep going.</div>
{{end}}

{{if and .Err (not .NeedsYou)}}<div class="empty" style="max-width:none;margin-bottom:var(--s5)">{{.Err}}</div>{{end}}

<div class="detail">
  {{/* ---------- main column ---------- */}}
  <div>
    <div class="metaline">
      {{if .WIType}}<span class="badge b-{{.WIType}}">{{.WIType}}</span>{{end}}
      <span class="badge b-{{or .WI.Priority "normal"}}">{{or .WI.Priority "normal"}}</span>
      <span class="badge b-{{.WI.Status}}">{{if or (eq .WI.Status "running") (eq .WI.Status "queued")}}<span class="dot"></span>{{end}}{{.WI.Status}}</span>
    </div>

    <h1 class="h-title">{{.WI.Goal}}</h1>

    {{if .Content}}
    <div class="card">
      <div class="hd"><h3>Background</h3></div>
      <div class="bd prose">{{md .Content}}</div>
    </div>
    {{end}}

    <div class="card">
      <div class="hd"><h3>Activity</h3><span class="role mono" style="font-size:11px">live</span></div>
      <div class="bd">
        {{/* HTMX poll: refresh the activity feed in place every 5s. The target
             swaps only the feed fragment so the card chrome stays put. */}}
        <div id="pf-events"
             hx-get="{{wiref (or .WI.Slug .WI.ID)}}/events/partial"
             hx-trigger="every 5s"
             hx-target="#pf-events"
             hx-swap="innerHTML">
          {{template "events_timeline.html.tmpl" .}}
        </div>
      </div>
    </div>
  </div>

  {{/* ---------- sidebar ---------- */}}
  <aside>
    <div class="card">
      <div class="hd"><h3>Details</h3></div>
      <div class="bd">
        <div class="meta-row">
          <span class="k">Reporter</span>
          <span class="v">{{template "person_chip" .Reporter}}</span>
        </div>
        <div class="meta-row">
          <span class="k">Assignee</span>
          <span class="v">{{template "person_chip" .Assignee}}</span>
        </div>
        <div class="meta-row"><span class="k">Project</span><span class="v mono">{{.WI.Project}}</span></div>
        {{/* Parent link (aihub#142) — only when this wi has a parent. Hidden
             cross-project parents show the placeholder instead of a link. */}}
        {{if .Parent}}
        <div class="meta-row">
          <span class="k">Parent</span>
          <span class="v">
            {{if .Parent.Hidden}}
              <span class="badge b-type">hidden</span>
            {{else}}
              {{if .Parent.Status}}<span class="badge b-{{.Parent.Status}}">{{.Parent.Status}}</span>{{end}}
              <a class="link mono" href="{{wiref .Parent.Slug}}">{{.Parent.Slug}}</a>
            {{end}}
          </span>
        </div>
        {{end}}
        {{if .Milestone}}<div class="meta-row"><span class="k">Milestone</span><span class="v">{{.Milestone}}</span></div>{{end}}
        {{if .HumanMode}}<div class="meta-row"><span class="k">Mode</span><span class="v">{{.HumanMode}}</span></div>{{end}}
        <div class="meta-row"><span class="k">Created</span><span class="v mono">{{.WI.CreatedAt.Format "2006-01-02 15:04 MST"}}</span></div>
        <div class="meta-row"><span class="k">Updated</span><span class="v mono">{{.WI.UpdatedAt.Format "2006-01-02 15:04 MST"}}</span></div>
        {{if .Labels}}
        <div class="meta-row">
          <span class="k">Labels</span>
          <span class="v" style="display:flex;flex-wrap:wrap;gap:5px;justify-content:flex-end">
            {{range .Labels}}<span class="badge b-type">{{.}}</span>{{end}}
          </span>
        </div>
        {{end}}
      </div>
    </div>

    {{/* Artifacts sit directly under the meta card, above the dependency
         blocks (review feedback). */}}
    <div class="card">
      <div class="hd"><h3>Artifacts</h3><span class="grp-n">{{len .Artifacts}}</span></div>
      <div class="bd">
        {{if .Artifacts}}
          {{range $i, $a := .Artifacts}}
          <div class="art-item{{if gt $i 0}} art-stack{{end}}">
            <div class="art">
              <span class="ico">{{artifactInitial $a.Type}}</span>
              <div class="art-meta">
                <div class="nm">{{$a.Type}}{{if $a.Versions}}<span class="vtag">v{{len $a.Versions}}</span>{{end}}</div>
                <div class="sub mono">{{$a.MemID}}</div>
              </div>
              <a class="link" href="/ui/artifacts/{{$a.MemID}}/html" target="_blank" rel="noopener">Open</a>
            </div>
            {{if $a.Versions}}
            {{/* Collapsible mini version timeline (supersede chain). Native
                 <details> — no JS. MemoryVersionRef carries id / created_at /
                 status / is_current only; there is no author or change-summary in
                 the domain type, so each row shows the version label, date, and
                 the current marker. Each version links to its own
                 /ui/artifacts/<id>/html. */}}
            <details class="vers-details">
              <summary><span class="chev"></span>{{len $a.Versions}} versions</summary>
              {{/* Versions are reversed newest-first in the handler; the version
                   number is total - displayIndex so labels stay chronological
                   (v{N} current on top ... v1 oldest at the bottom). */}}
              {{$n := len $a.Versions}}
              <div class="vlist">
                {{range $vi, $v := $a.Versions}}
                <div class="vrow{{if $v.IsCurrent}} cur{{end}}">
                  <span class="vdot"></span>
                  <div class="vrow-body">
                    <b>v{{sub $n $vi}}</b>{{if $v.IsCurrent}}<span class="vcur">current</span>{{end}}
                    <div class="vmeta">{{shortDate $v.CreatedAt}}{{if $v.Status}} · {{$v.Status}}{{end}}</div>
                  </div>
                  <a class="link" href="/ui/artifacts/{{$v.ID}}/html" target="_blank" rel="noopener" style="font-size:11px">View</a>
                </div>
                {{end}}
              </div>
            </details>
            {{end}}
          </div>
          {{end}}
        {{else}}
          <div class="empty" style="max-width:none;padding:14px;border:0"><div class="et">Nothing here</div>No artifacts yet.</div>
        {{end}}
      </div>
    </div>

    {{/* Blocked by — the wis that block THIS one (see toDepView for the
         direction note). */}}
    <div class="card">
      <div class="hd"><h3>Blocked by</h3><span class="grp-n">{{if .Dependencies}}{{len .Dependencies.BlockedBy}}{{else}}0{{end}}</span></div>
      <div class="bd">
        {{if and .Dependencies .Dependencies.BlockedBy}}
          {{range .Dependencies.BlockedBy}}{{template "dep_row" .}}{{end}}
        {{else}}
          <div class="empty" style="max-width:none;padding:14px;border:0"><div class="et">Nothing here</div>No blocking dependencies.</div>
        {{end}}
      </div>
    </div>

    {{/* Blocking — the wis THIS one blocks. */}}
    <div class="card">
      <div class="hd"><h3>Blocking</h3><span class="grp-n">{{if .Dependencies}}{{len .Dependencies.Blocking}}{{else}}0{{end}}</span></div>
      <div class="bd">
        {{if and .Dependencies .Dependencies.Blocking}}
          {{range .Dependencies.Blocking}}{{template "dep_row" .}}{{end}}
        {{else}}
          <div class="empty" style="max-width:none;padding:14px;border:0"><div class="et">Nothing here</div>Not blocking anything.</div>
        {{end}}
      </div>
    </div>

    {{/* Children — sub-items whose parent_work_item_id points at THIS wi
         (aihub#142). Ordered by seq ASC. The pill is a plain count, not a
         progress ratio. The card is omitted entirely when there are no
         children so a leaf wi stays uncluttered. Rows reuse the shared dep_row
         partial (slug link + status badge + owner avatar; hidden placeholder
         for cross-project children). */}}
    {{if .Children}}
    <div class="card">
      <div class="hd"><h3>Children</h3><span class="grp-n">{{len .Children}}</span></div>
      <div class="bd">
        {{range .Children}}{{template "dep_row" .}}{{end}}
      </div>
    </div>
    {{end}}
  </aside>
</div>
{{end}}
{{end}}

{{/* ---- person-chip partial: full chip with name; ghost when unassigned ---- */}}
{{define "person_chip"}}
{{if .Display}}
<span class="who"><span class="av {{.ColorClass}}">{{.Initials}}</span><span class="nm">{{.Display}}</span></span>
{{else}}
<span class="who" title="unassigned"><span class="av ghost">?</span><span class="role">unassigned</span></span>
{{end}}
{{end}}

{{/* ---- dependency row: status badge + slug link + owner avatar ---- */}}
{{define "dep_row"}}
<div class="dep">
  {{if .Hidden}}
    <span class="badge b-type">hidden</span>
    <span class="txt">cross-project</span>
  {{else}}
    {{if .Status}}<span class="badge b-{{.Status}}">{{if or (eq .Status "running") (eq .Status "queued")}}<span class="dot"></span>{{end}}{{.Status}}</span>{{end}}
    <a class="id link" href="{{wiref .Slug}}">{{.Slug}}</a>
    <span style="flex:1"></span>
    {{if .Assignee.Display}}
      <span class="who" title="owner: {{.Assignee.Display}}"><span class="av sm {{.Assignee.ColorClass}}">{{.Assignee.Initials}}</span></span>
    {{else}}
      <span class="who" title="unassigned"><span class="av sm ghost">?</span></span>
    {{end}}
  {{end}}
</div>
{{end}}
