{{define "content"}}
<section class="ph">
  <h1>Work Items</h1>
  {{/* Project switcher — custom dropdown (unchanged by aihub#185). Selecting an
       option sets the hidden `project` field on the filter form and fires the
       shared HTMX request, so the list updates in place while carrying the
       current seg / owner params. Counts come from ProjectCounts. */}}
  <div class="dd" data-dd>
    <button type="button" class="dd-btn" data-dd-btn>
      <span class="lbl">{{.ProjectLabel}}</span><span class="chev open" style="margin:0"></span>
    </button>
    <div class="dd-menu" hidden>
      <div class="dd-it{{if .AllMode}} on{{end}}" data-dd-field="project" data-dd-value="__all__" data-dd-label="All projects">
        All projects<span style="flex:1"></span><span class="cnt">{{.TotalCount}}</span><span class="ck"></span>
      </div>
      {{range .ProjectsAvailable}}
      <div class="dd-it{{if and (not $.AllMode) (eq . $.Project)}} on{{end}}" data-dd-field="project" data-dd-value="{{.}}" data-dd-label="{{.}}">
        {{.}}<span style="flex:1"></span><span class="cnt">{{index $.ProjectCounts .}}</span><span class="ck"></span>
      </div>
      {{end}}
    </div>
  </div>
</section>

{{/* Filter bar (aihub#185). The status multi-select dropdown + count strip are
     gone — status is now the right sidebar (LCRS segments), rendered inside
     #wi-list-body below. The form still drives an in-place HTMX reload for the
     project switcher and the Mine/All segment (they fire `pf-filter`); search and
     sort are CLIENT-SIDE (dropdown.js filters/reorders the rendered rows, no
     server round-trip — decision A: search is scoped to the current segment).
     hx-include="this" carries project + owner/all + the selected seg, so a
     project switch or Mine/All toggle preserves the chosen segment. */}}
<form method="GET" action="/ui/wi" class="filters" data-wi-filters
      hx-get="/ui/wi"
      hx-target="#wi-list-body"
      hx-swap="innerHTML"
      hx-push-url="true"
      hx-include="this"
      hx-trigger="pf-filter">
  <input type="hidden" name="project" value="{{if .AllMode}}__all__{{else}}{{.Project}}{{end}}" data-dd-input="project">
  <input type="hidden" name="kind" value="{{.Kind}}">
  <input type="hidden" name="reporter" value="{{.Reporter}}">
  {{/* owner: no-JS fallback / initial. With JS the header "me" toggle's live state
       is injected at request time (dropdown.js htmx:configRequest). Empty = All. */}}
  <input type="hidden" name="owner" value="{{.Owner}}">
  {{/* seg: no-JS fallback; with JS the live selected segment (active sidebar item)
       is injected at request time so a project/owner reload preserves it. */}}
  <input type="hidden" name="seg" value="{{.SelectedSeg}}" data-seg-keep>

  <label class="search">
    <span>search</span>
    <input type="text" name="q" placeholder="Filter by title, id, label..." data-wi-search autocomplete="off" aria-label="Filter work items in this segment">
  </label>

  {{/* Owner scope moved to the header "me" toggle (aihub#185 follow-up); default
       view is All. Watching removed — re-added by aihub#143 when it lands. */}}
  <noscript><button type="submit" class="btn sm">Apply</button></noscript>
</form>

{{/* Two-column body lives ENTIRELY inside #wi-list-body so a segment click (or a
     project / Mine-All change) re-renders BOTH the sidebar (selected highlight +
     counts) and the middle list in one swap. The handler renders this same block
     standalone for HX-Request fragment responses. */}}
<div id="wi-list-body">
{{template "wi-list-body" .}}
</div>
{{end}}

{{/* Standalone list-body fragment — the full two-column layout. */}}
{{define "wi-list-body"}}
{{if .Err}}<div class="empty" style="max-width:none">{{.Err}}</div>{{else}}
<div class="wi-layout">

  {{/* LEFT — the selected segment's rows. The .grp header carries the segment
       label, the client-side sort toggle (newest ↓ / oldest ↑, wired by
       dropdown.js over data-created), and the segment's live total count. */}}
  <div class="wi-main">
    <div class="list" data-wi-list>
      <div class="grp-wrap" data-grp>
      <div class="grp">
        {{range .Segments}}{{if .On}}<span class="grp-l">{{.Label}}</span>{{end}}{{end}}
        {{if .User}}<button type="button" class="grp-me{{if .Mine}} on{{end}}" data-me-toggle data-me-owner="{{.User.DisplayName}}" title="只看我认领的(关闭=全部)">me</button>{{end}}
        <button type="button" class="grp-sort" data-wi-sort title="按创建时间排序(点击切换最新/最旧在前)" aria-label="toggle sort order">↓</button>
        <span class="grp-n">{{index .SegCounts .SelectedSeg}}</span>
      </div>
      <div class="grp-rows" data-grp-rows>
      {{if .SegRows}}
      {{range .SegRows}}
      <a class="row{{if .NeedsYou}} hot{{end}}" href="{{wiref (or .Slug .ID)}}"
         data-wi-row
         data-created="{{.CreatedAt.Unix}}"
         data-wi-text="{{.Slug}} {{.Goal}} {{.Project}} {{.WIType}} {{or .Priority "normal"}}">
        <span class="id">{{or .Slug .ID}}</span>
        <span class="ti">
          <div class="t">{{.Goal}}</div>
          <div class="m">
            {{if .WIType}}<span class="badge b-{{.WIType}}">{{.WIType}}</span>{{end}}
            <span class="badge b-{{or .Priority "normal"}}">{{or .Priority "normal"}}</span>
            {{if $.AllMode}}<span class="mono">{{.Project}}</span>{{end}}
          </div>
        </span>
        <span class="rt">
          <span class="badge b-{{.Status}}">{{if or (eq .Status "running") (eq .Status "queued")}}<span class="dot"></span>{{end}}{{.Status}}</span>
          {{if .Assignee.Display}}
            <span class="who" title="{{.Assignee.Display}}"><span class="av lg {{.Assignee.ColorClass}}">{{.Assignee.Initials}}</span></span>
          {{else}}
            <span class="who" title="unassigned"><span class="av lg ghost">?</span></span>
          {{end}}
        </span>
      </a>
      {{end}}
      {{else}}
      {{/* Empty segment — full-width empty-state inside the list card. */}}
      <div class="empty" style="max-width:none;border:0;padding:26px 18px;margin:0">
        <div class="et">Nothing here</div>
        {{range .Segments}}{{if .On}}No work items in “{{.Label}}”.{{end}}{{end}}
      </div>
      {{end}}
      </div>
      {{/* Pager footer (aihub#185): page-info + per-page picker (default 10) +
           numbered page buttons. dropdown.js fills it; the footer shows whenever
           the segment has rows, the page buttons only when the rows span >1 page. */}}
      <div class="pager" data-wi-pager hidden>
        <span class="pinfo" data-grp-pinfo></span>
        <span class="pp-label">每页</span>
        <div class="seg" data-wi-perpage title="每页条数">
          <button type="button" class="on" data-perpage="10">10</button>
          <button type="button" data-perpage="25">25</button>
          <button type="button" data-perpage="50">50</button>
          <button type="button" data-perpage="100">100</button>
        </div>
        <span style="flex:1"></span>
        <div class="grp-pager" data-grp-pager></div>
      </div>
      </div>
    </div>
  </div>

  {{/* RIGHT — LCRS segment sidebar. Single-select; each item is an HTMX link that
       swaps #wi-list-body (re-rendering this whole layout, so the .on highlight +
       middle update together). Carries project + all so the view is preserved. */}}
  <aside class="seg-nav">
    <div class="seg-title">Status</div>
    {{$proj := "__all__"}}{{if not .AllMode}}{{$proj = .Project}}{{end}}
    {{range .Segments}}
    {{if .Divider}}<div class="seg-div"></div>{{end}}
    <a class="seg-item{{if .On}} on{{end}}" data-seg-key="{{.Key}}"
       href="/ui/wi?seg={{.Key}}&project={{$proj}}&owner={{$.Owner}}"
       hx-get="/ui/wi?seg={{.Key}}&project={{$proj}}"
       hx-target="#wi-list-body" hx-swap="innerHTML" hx-push-url="true">
      {{.Label}}<span class="cnt">{{.Count}}</span>
    </a>
    {{end}}
  </aside>

</div>
{{end}}
{{end}}
